                    ],
    "drawingRules":  [
                         {
                             "id":  "thick-outline",
                             "instruction":  "Thick dark outline around the complete silhouette.",
                             "method":  "human",
                             "required":  true
                         },
                         {
                             "id":  "flat-value-blocks",
                             "instruction":  "Flat color blocks with 2-3 hard value steps; no smooth gradients.",
                             "method":  "human",
                             "required":  true
                         },
                         {
                             "id":  "capsule-first-read",
                             "instruction":  "Silhouette reads as a compact upright capsule before species details.",
                             "method":  "human",
                             "required":  true
                         },
                         {
                             "id":  "no-limbs",
                             "instruction":  "No human arms or legs; wings are surface patches and feet are stubs attached to the capsule.",
                             "method":  "human",
                             "required":  true
                         },
                         {
                             "id":  "canvas-alpha",
