{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cty41/maliang/v0.1.0/schemas/v1/pose-card.schema.json",
  "title": "MaLiang selected pose card v1",
  "description": "Structural validation is self-contained; maliang_art.pose.validate_card also verifies cross-field constraints and the canonical poseProofId.",
  "$defs": {
    "nonBlank": {"type": "string", "pattern": "\\S"},
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 8191},
        {"type": "integer", "minimum": 0, "maximum": 8191}
      ],
      "items": false
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\\\]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "visualMoment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "phase", "spriteRole"],
      "properties": {
        "consumer": {"$ref": "#/$defs/nonBlank"},
        "phase": {"$ref": "#/$defs/nonBlank"},
        "spriteRole": {"$ref": "#/$defs/nonBlank"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "title", "caption", "head", "spine", "segments", "supportPoints", "contactPoints", "equipmentAxis"],
      "properties": {
        "optionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
        "title": {"$ref": "#/$defs/nonBlank"},
        "caption": {"$ref": "#/$defs/nonBlank"},
        "head": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center", "radius"],
          "properties": {
            "center": {"$ref": "#/$defs/point"},
            "radius": {"type": "integer", "minimum": 1, "maximum": 2048}
          }
        },
        "spine": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}},
        "segments": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}}},
        "supportPoints": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "contactPoints": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "equipmentAxis": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}}]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "poseProofId", "assetId", "characterId", "poseId", "direction", "canvas", "visualMoment", "selectedOption", "selection"],
  "properties": {
    "schemaVersion": {"const": 1},
    "poseProofId": {"type": "string", "pattern": "^pose-proof-[0-9a-f]{16}$"},
    "assetId": {"$ref": "#/$defs/nonBlank"},
    "characterId": {"$ref": "#/$defs/nonBlank"},
    "poseId": {"$ref": "#/$defs/nonBlank"},
    "direction": {"enum": ["down-right", "up-left", "down-left", "up-right", "non-directional"]},
    "canvas": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 16, "maximum": 8192}},
    "visualMoment": {"$ref": "#/$defs/visualMoment"},
    "selectedOption": {"$ref": "#/$defs/option"},
    "historicalEvidence": {"$ref": "#/$defs/artifact"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "reviewer", "reason", "rejectedOptions", "selectedAt"],
      "properties": {
        "optionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
        "reviewer": {"$ref": "#/$defs/nonBlank"},
        "reason": {"$ref": "#/$defs/nonBlank"},
        "selectedAt": {"type": "string", "format": "date-time"},
        "rejectedOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["optionId", "reason"],
            "properties": {
              "optionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
              "reason": {"$ref": "#/$defs/nonBlank"}
            }
          }
        }
      }
    }
  }
}
