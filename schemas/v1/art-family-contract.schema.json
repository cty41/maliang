{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art family contract v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "familyId", "camera", "silhouettes", "attachments", "drawingRules", "paletteRoles", "targets", "statePolicy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "familyId": {"type": "string", "minLength": 1},
    "camera": {"type": "object", "additionalProperties": false, "required": ["mode", "profile", "mirrorAccepted"], "properties": {
      "mode": {"type": "string", "minLength": 1, "description": "design validate supports isometric (DR/UL), side (R), top-down (D/U/R) and front (F); each mode requires its fixed profile, and unused directions are none."}, "mirrorAccepted": {"type": "boolean"},
      "profile": {"type": "object", "additionalProperties": false, "required": ["North", "South", "East", "West"], "properties": {"North": {"type": "string"}, "South": {"type": "string"}, "East": {"type": "string"}, "West": {"type": "string"}}}
    }},
    "silhouettes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attachments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "drawingRules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "instruction", "method", "required"], "properties": {"id": {"type": "string", "minLength": 1}, "instruction": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}}},
    "paletteRoles": {"$ref": "#/$defs/palette"},
    "targets": {"$ref": "#/$defs/targets"},
    "variants": {"description": "Optional numeric debug-layout parameters; unapproved and not generation input.", "type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["id", "coreWidth", "coreHeight"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "coreWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "coreHeight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}},
    "statePolicy": {"type": "object", "additionalProperties": false, "required": ["allowedCoreTransforms", "allowedPartChanges"], "properties": {"allowedCoreTransforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "allowedPartChanges": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 8, "maximum": 2048}},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "palette": {"type": "object", "additionalProperties": false, "required": ["main", "secondary", "outline", "accent"], "properties": {"main": {"$ref": "#/$defs/color"}, "secondary": {"$ref": "#/$defs/color"}, "outline": {"$ref": "#/$defs/color"}, "accent": {"$ref": "#/$defs/color"}}},
    "targets": {"type": "object", "additionalProperties": false, "required": ["sourceSize", "outputSize", "anchorX", "groundY", "displaySizes", "contextBoard", "tolerance"], "properties": {
      "sourceSize": {"$ref": "#/$defs/size"}, "outputSize": {"$ref": "#/$defs/size"},
      "anchorX": {"type": "number", "minimum": 0}, "groundY": {"type": "number", "minimum": 0},
      "displaySizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 8, "maximum": 2048}},
      "tolerance": {"type": "number", "minimum": 0},
      "contextBoard": {"type": "object", "additionalProperties": false, "required": ["cellSize", "columns"], "properties": {"cellSize": {"$ref": "#/$defs/size"}, "columns": {"type": "integer", "minimum": 1, "maximum": 4}}}
    }}
  }
}
