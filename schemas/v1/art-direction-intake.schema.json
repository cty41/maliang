{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art direction intake v1",
  "description": "Answers a human gave to an art direction catalog, with the options actually presented and where each answer came from.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "intakeId", "catalogId", "request", "answers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "intakeId": {"type": "string", "minLength": 1},
    "catalogId": {"type": "string", "minLength": 1},
    "request": {"type": "string", "minLength": 1},
    "answers": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["dimension", "source", "presented"], "properties": {
      "dimension": {"type": "string", "minLength": 1},
      "option": {"type": "string", "minLength": 1},
      "text": {"type": "string", "minLength": 1},
      "source": {"enum": ["catalog-option", "ai-suggested-option", "user-text", "ai-inferred-confirmed"]},
      "confirmation": {"type": "string", "minLength": 1},
      "followUpOf": {"type": "string", "minLength": 1},
      "prompt": {"type": "string", "minLength": 1},
      "presented": {"type": "array", "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "label", "source"], "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "source": {"enum": ["catalog", "ai"]}
      }}}
    }}}
  }
}
