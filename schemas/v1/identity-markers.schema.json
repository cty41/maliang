{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity markers v1",
  "description": "Recognition features that carry a character from concept art into in-game capsule assets.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "markersId", "characterId", "status", "conceptIds", "markers", "palette", "tolerance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "markersId": {"type": "string", "minLength": 1},
    "characterId": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "frozen"]},
    "conceptIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "readingIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1},
      "description": "Art readings these markers were drafted from; frozen markers require confirmed identity readings."},
    "markers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "description", "category", "required", "capsuleTranslation"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "description": {"type": "string", "minLength": 1},
      "category": {"enum": ["species-silhouette", "costume-color", "weapon", "accessory", "mark", "transformation"]},
      "required": {"type": "boolean"},
      "capsuleTranslation": {"type": "string", "minLength": 1},
      "forms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1},
        "description": "Concept forms this marker applies to; omitted means every form."}
    }}},
    "palette": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "hex"], "properties": {
      "role": {"type": "string", "minLength": 1},
      "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    }}},
    "tolerance": {"type": "number", "minimum": 0, "maximum": 442}
  }
}
