{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived usage v1",
  "description": "A portrait bust or promotional use derived from one character concept.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "usageId", "conceptId", "kind", "purpose", "approval"],
  "properties": {
    "schemaVersion": {"const": 1},
    "usageId": {"type": "string", "minLength": 1},
    "conceptId": {"type": "string", "minLength": 1},
    "kind": {"enum": ["portrait-bust", "promo"]},
    "purpose": {"type": "string", "minLength": 1},
    "crop": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {
      "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
      "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
    }},
    "approval": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {
      "status": {"enum": ["pending", "approved", "rejected"]},
      "reviewer": {"type": "string", "minLength": 1},
      "reviewerSource": {"enum": ["git-config", "os-user", "manual"]},
      "reviewedAt": {"type": "string", "minLength": 1},
      "note": {"type": "string"}
    }}
  },
  "if": {"properties": {"kind": {"const": "portrait-bust"}}},
  "then": {"required": ["crop"]}
}
