{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art direction catalog v1",
  "description": "Project-owned question tree for turning a broad art request into explicit decisions. Not universal art rules.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "dimensions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogId": {"type": "string", "minLength": 1},
    "dimensions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "prompt", "priority", "optionsMode", "options"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "prompt": {"type": "string", "minLength": 1},
      "priority": {"type": "integer", "minimum": 1},
      "optionsMode": {"enum": ["fixed", "suggest", "free"]},
      "when": {"$ref": "#/$defs/condition"},
      "whenMode": {"enum": ["all", "any"]},
      "options": {"type": "array", "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "label", "references", "consequence", "risk"], "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "references": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "consequence": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "maps": {"type": "object", "additionalProperties": false, "required": ["target", "field", "value"], "properties": {
          "target": {"enum": ["styleGuide", "contract"]},
          "field": {"type": "string", "minLength": 1},
          "value": {}
        }},
        "recommendWhen": {"$ref": "#/$defs/condition"},
        "stop": {"type": "string", "minLength": 1}
      }}}
    }}}
  },
  "$defs": {
    "condition": {"type": "object", "minProperties": 1, "additionalProperties": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    }}
  }
}
