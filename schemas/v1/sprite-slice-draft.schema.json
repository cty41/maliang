{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seven-group sprite slice draft v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "identity", "topology", "silhouetteClass", "visualMoment", "paletteRoles", "targets", "references"],
  "properties": {
    "schemaVersion": {"const": 1},
    "identity": {"type": "object", "additionalProperties": false, "required": ["species", "features", "priority", "forbiddenMirror"], "properties": {"species": {"type": "string", "minLength": 1}, "features": {"$ref": "#/$defs/nonemptyTexts"}, "priority": {"$ref": "#/$defs/nonemptyTexts"}, "forbiddenMirror": {"$ref": "#/$defs/texts"}}},
    "topology": {"type": "object", "additionalProperties": false, "required": ["core", "parts", "prohibited"], "properties": {
      "core": {"type": "string", "minLength": 1}, "prohibited": {"$ref": "#/$defs/texts"},
      "parts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "anchor": {"description": "Optional debug-layout coordinate, not a visual design constraint.", "$ref": "#/$defs/unitPair"}, "size": {"description": "Optional debug-layout extent, not a visual design constraint.", "$ref": "#/$defs/positivePair"}}}}
    }},
    "silhouetteClass": {"type": "string", "minLength": 1},
    "visualMoment": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["view", "state", "moment", "coreTransform", "partChanges"], "properties": {"view": {"type": "string", "minLength": 1}, "state": {"type": "string", "minLength": 1}, "moment": {"type": "string", "minLength": 1}, "coreTransform": {"type": "string", "minLength": 1}, "partChanges": {"$ref": "#/$defs/texts"}}}},
    "paletteRoles": {"type": "object", "additionalProperties": false, "properties": {"main": {"$ref": "#/$defs/color"}, "secondary": {"$ref": "#/$defs/color"}, "outline": {"$ref": "#/$defs/color"}, "accent": {"$ref": "#/$defs/color"}}},
    "targets": {"type": "object", "additionalProperties": false, "properties": {
      "sourceSize": {"$ref": "#/$defs/size"}, "outputSize": {"$ref": "#/$defs/size"}, "anchorX": {"type": "number", "minimum": 0}, "groundY": {"type": "number", "minimum": 0}, "tolerance": {"type": "number", "minimum": 0},
      "displaySizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 8, "maximum": 2048}},
      "contextBoard": {"type": "object", "additionalProperties": false, "required": ["cellSize", "columns"], "properties": {"cellSize": {"$ref": "#/$defs/size"}, "columns": {"type": "integer", "minimum": 1, "maximum": 4}}}
    }},
    "references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "roles", "borrow", "forbid"], "properties": {
      "path": {"type": "string", "pattern": "^[^\\\\:/]+(?:/[^\\\\:/]+)*$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["style", "identity", "shape", "pose"]}}, "borrow": {"$ref": "#/$defs/nonemptyTexts"}, "forbid": {"$ref": "#/$defs/texts"}
    }}}
  },
  "$defs": {
    "texts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonemptyTexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unitPair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "positivePair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
    "size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 8, "maximum": 2048}},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
  }
}
