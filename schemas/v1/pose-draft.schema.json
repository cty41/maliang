{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cty41/maliang/schemas/v1/pose-draft.schema.json",
  "title": "MaLiang pose draft v1",
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 8191}, {"type": "integer", "minimum": 0, "maximum": 8191}], "items": false},
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["optionId", "title", "caption", "head", "spine", "segments", "supportPoints", "contactPoints", "equipmentAxis"],
      "properties": {
        "optionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
        "title": {"type": "string", "minLength": 1}, "caption": {"type": "string", "minLength": 1},
        "head": {"type": "object", "additionalProperties": false, "required": ["center", "radius"], "properties": {"center": {"$ref": "#/$defs/point"}, "radius": {"type": "integer", "minimum": 1, "maximum": 2048}}},
        "spine": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}},
        "segments": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}}},
        "supportPoints": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "contactPoints": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "equipmentAxis": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}}]}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "characterId", "poseId", "direction", "visualMoment", "canvas", "options"],
  "properties": {
    "schemaVersion": {"const": 1}, "assetId": {"type": "string", "minLength": 1}, "characterId": {"type": "string", "minLength": 1}, "poseId": {"type": "string", "minLength": 1},
    "direction": {"enum": ["down-right", "up-left", "down-left", "up-right", "non-directional"]},
    "visualMoment": {"type": "object", "additionalProperties": false, "required": ["consumer", "phase", "spriteRole"], "properties": {"consumer": {"type": "string", "minLength": 1}, "phase": {"type": "string", "minLength": 1}, "spriteRole": {"type": "string", "minLength": 1}}},
    "canvas": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 16, "maximum": 8192}}, "options": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/option"}},
    "historicalEvidence": {"$ref": "artifact.schema.json"}
  }
}
