{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept style guide v1",
  "description": "Style rules for concept art; independent from the in-game art family contract.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "styleId", "track", "framing", "references", "rules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "styleId": {"type": "string", "minLength": 1},
    "track": {"enum": ["concept", "promo"]},
    "framing": {"type": "object", "additionalProperties": false, "required": ["subject", "body", "background"], "properties": {
      "subject": {"type": "string", "minLength": 1},
      "body": {"type": "string", "minLength": 1},
      "background": {"type": "string", "minLength": 1}
    }},
    "references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["title", "borrow", "forbid"], "properties": {
      "title": {"type": "string", "minLength": 1},
      "borrow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "forbid": {"type": "array", "items": {"type": "string", "minLength": 1}}
    }}},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "instruction", "method", "required"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "instruction": {"type": "string", "minLength": 1},
      "method": {"enum": ["deterministic", "human"]},
      "required": {"type": "boolean"}
    }}}
  }
}
